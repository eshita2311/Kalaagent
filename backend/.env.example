# Copy this file to .env and fill in your real keys. Never commit .env itself.

# Get from https://console.groq.com/keys (free, no credit card needed)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx

# Get from Razorpay Dashboard > Settings > API Keys (make sure you're in TEST MODE)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxx

# Port the backend server runs on
PORT=4000

# Frontend origin allowed to call this API (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Secret used to sign login sessions (JWT). Use any long random string —
# it doesn't need to be memorable, just unique to your deployment.
JWT_SECRET=change-this-to-any-long-random-string-before-deploying
